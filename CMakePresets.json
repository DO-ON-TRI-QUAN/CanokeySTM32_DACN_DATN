{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },

  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Shared by STM32CubeIDE and build.sh. -Os with full debug info.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "${sourceDir}/toolchain.cmake",
      "cacheVariables": {
        "CROSS_COMPILE": "arm-none-eabi-",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "dumb",
      "displayName": "DUMB_DONGLE - user presence DISABLED",
      "description": "Development only. All user-presence checks removed, including factory reset confirmation. Shared by STM32CubeIDE and build.sh --dumb.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/dumb",
      "cacheVariables": {
        "ENABLE_DUMB_DONGLE": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "release", "displayName": "Release",     "configurePreset": "release" },
    { "name": "dumb",    "displayName": "DUMB_DONGLE", "configurePreset": "dumb" }
  ]
}
